# Claude API — used by ai_analysis for filing/transcript analysis
ANTHROPIC_API_KEY=

# Market data — provide the key for whichever provider DATA_PROVIDER selects below
FMP_API_KEY=
POLYGON_API_KEY=

# QuiverQuant — alternative data (congressional trading, insider activity, etc.)
QUIVERQUANT_API_KEY=

# FRED — macroeconomic series
FRED_API_KEY=

# Which market data provider data/ingestion should use: "fmp" or "polygon"
DATA_PROVIDER=fmp
