# Gemini (Google) API — used by ai_analysis for filing/transcript analysis
GOOGLE_API_KEY=

# QuiverQuant — paid alt-data (congressional/insider trading); kept because there's
# no free equivalent for this signal. Leave blank to skip alt-data ingestion.
QUIVERQUANT_API_KEY=

# FRED — free macroeconomic series, no paid tier needed
FRED_API_KEY=

# FMP — used for fundamentals (income statement, balance sheet, ratios)
FMP_API_KEY=

# SEC EDGAR requires a descriptive User-Agent identifying you/your org on every
# request. Set these to your real details before running SEC ingestion.
SEC_EDGAR_CONTACT_NAME=Hedge Fund Research
SEC_EDGAR_CONTACT_EMAIL=research@example.com
